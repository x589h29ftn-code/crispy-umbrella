// Datamodel van het ondertekenportaal. PostgreSQL. Alle tijdstempels in UTC.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEDEWERKER
  BEHEERDER
}

enum PartyRole {
  ZELF
  EXTERN
}

enum PartyStatus {
  PENDING
  SIGNED
  DECLINED
}

enum FieldKind {
  SIGNATURE
  DATE
  INITIALS
}

enum DossierStatus {
  CONCEPT
  VERZONDEN
  GEDEELTELIJK
  ONDERTEKEND
  GEWEIGERD
  VERLOPEN
}

enum VerificationMethod {
  EMAIL
  SMS
}

enum SigningMode {
  PARALLEL // iedereen tegelijk
  SEQUENTIAL // één voor één, op volgorde
}

/// Herkend documenttype (voor automatische titel/berichtsuggestie).
enum DocumentKind {
  JAARREKENING // jaarrekening (wordt in de jaarrekening zelf getekend)
  NOTULEN_AVA // notulen algemene vergadering van aandeelhouders
  BEVESTIGING_JAARREKENING // bevestiging bij de jaarrekening
  AKKOORD_IB // akkoordverklaring aangifte inkomstenbelasting
  AKKOORD_VPB // akkoordverklaring aangifte vennootschapsbelasting
  OPDRACHTBEVESTIGING // opdrachtbevestiging (nieuwe klanten)
  OVERIG // niet herkend
}

/// Medewerker/accountant van het kantoor.
model Accountant {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEDEWERKER)
  totpSecret   String? // versleuteld opgeslagen (AES-256-GCM)
  totpEnabled  Boolean  @default(false)
  totpBackupCodes String[] @default([]) // SHA-256-hashes van eenmalige herstelcodes
  // Wachtwoord-vergeten: eenmalige, kortlevende herstellink (alleen hash bewaard).
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  signaturePng String? // opgeslagen handtekening (data-URL of opslagsleutel)
  mustChangePassword Boolean @default(false) // nieuw aangemaakt account
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  dossiers        Dossier[]
  auditEvents     AuditEvent[]
  signerFor       Recipient[] // dossiers waarin deze medewerker een ondertekenaar is
}

/// Intrekbare serversessie. Alleen de hash van het sessietoken wordt bewaard.
model Session {
  id           String     @id @default(cuid())
  accountantId String
  accountant   Accountant @relation(fields: [accountantId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  ip           String?
  userAgent    String?

  @@index([accountantId])
}

/// Cliëntendatabase van het kantoor (voor automatisch invullen van ontvangers).
model Client {
  id          String   @id @default(cuid())
  clientNumber String? // intern klantnummer (bijv. voor de mapstructuur in het archief)
  displayName String
  companyName String?
  contactName String?
  firstName   String? // voornaam, voor een nette aanhef in berichten
  email       String?
  phone       String?
  kvk         String?
  address     String?
  postalCode  String?
  city        String?
  country     String   @default("Nederland")
  notes       String?
  // Voorkeur voor identiteitsverificatie bij ondertekenen (standaard e-mail).
  verificationMethod VerificationMethod @default(EMAIL)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients Recipient[]

  @@index([displayName])
  @@index([email])
}

/// Eén ondertekenverzoek/-workflow. Kan meerdere documenten bevatten die de
/// ontvanger(s) in één keer ondertekenen (bijv. akkoordverklaring IB én VPB).
model Dossier {
  id             String        @id @default(cuid())
  title          String
  status         DossierStatus @default(CONCEPT)
  ownerId        String
  owner          Accountant    @relation(fields: [ownerId], references: [id])
  message        String? // optioneel begeleidend bericht in de e-mail
  // Ontvanger na afronding ook een kopie mailen (standaard aan).
  sendCopyToRecipient Boolean @default(true)
  // Volgorde van ondertekenen: iedereen tegelijk of één voor één.
  signingMode         SigningMode @default(PARALLEL)
  // Geldigheidsduur van de tekenlink in dagen (instelbaar bij verzenden).
  linkTtlDays         Int         @default(10)
  expiresAt      DateTime?
  sentAt         DateTime?
  lastReminderAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  documents   Document[]
  recipients  Recipient[]
  fields      SignatureField[]
  auditEvents AuditEvent[]

  @@index([ownerId, status])
}

/// Eén te ondertekenen document binnen een dossier, met eigen titel.
model Document {
  id             String   @id @default(cuid())
  dossierId      String
  dossier        Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  title          String
  fileName       String
  order          Int      @default(0)
  originalKey    String? // opslagsleutel: bron-PDF (na eventuele Word-conversie)
  workingKey     String? // opslagsleutel: PDF met reeds gezette handtekeningen
  sealedKey      String? // opslagsleutel: definitieve, verzegelde PDF
  documentSha256 String?
  // Automatische herkenning bij upload (suggestie; door de gebruiker aanpasbaar).
  detectedKind   DocumentKind?
  detectedYear   Int?
  ocrUsed        Boolean       @default(false)
  createdAt      DateTime @default(now())

  fields SignatureField[]

  @@index([dossierId])
}

/// Een partij die moet tekenen (accountant zelf of externe ontvanger).
model Recipient {
  id             String      @id @default(cuid())
  dossierId      String
  dossier        Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?     @relation(fields: [clientId], references: [id])
  // Kantoorgebruiker die tekent (role = ZELF); leeg voor externe cliënten.
  accountantId   String?
  accountant     Accountant? @relation(fields: [accountantId], references: [id])
  role           PartyRole   @default(EXTERN)
  name           String
  email          String
  phone          String?
  verificationMethod VerificationMethod @default(EMAIL)
  order          Int         @default(0)
  status         PartyStatus @default(PENDING)
  signedAt       DateTime?
  declinedReason String?

  // E-mail-OTP (2e factor voor de ondertekenaar) — gehasht opgeslagen.
  otpHash       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpVerifiedAt DateTime?

  // Eenmalige, kortlevende tekentoken — alleen de hash bewaren.
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  tokenUsedAt    DateTime?

  createdAt DateTime         @default(now())
  fields    SignatureField[]

  @@index([dossierId])
}

/// Een geplaatst tekenvak (PDF-punten, pivot linksonder) op één document.
model SignatureField {
  id          String     @id @default(cuid())
  dossierId   String
  dossier     Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipientId String? // null = eigen veld van de accountant
  recipient   Recipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  kind        FieldKind  @default(SIGNATURE)
  page        Int
  x           Float
  y           Float
  width       Float
  height      Float
  filled      Boolean    @default(false)

  @@index([dossierId])
  @@index([documentId])
}

/// Append-only auditspoor.
model AuditEvent {
  id           String      @id @default(cuid())
  dossierId    String?
  dossier      Dossier?    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  accountantId String?
  accountant   Accountant? @relation(fields: [accountantId], references: [id])
  recipientId  String?
  type         String
  message      String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([dossierId])
}

/// Aanpasbaar tekstsjabloon per documenttype (titel + begeleidend bericht).
/// Ontbreekt er een rij voor een type, dan geldt de standaardtekst uit de code.
model MessageTemplate {
  id            String       @id @default(cuid())
  kind          DocumentKind @unique
  titleTemplate String
  bodyTemplate  String
  updatedAt     DateTime     @updatedAt
  updatedById   String?
}
