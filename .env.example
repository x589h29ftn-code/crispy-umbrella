# === Kernconfiguratie ===
# Publieke URL van het portaal (gebruikt in e-maillinks). Geen slash op het einde.
APP_URL="https://portaal.ottovisseraccountants.nl"
NODE_ENV="production"

# === Database ===
# PostgreSQL-verbinding. In docker-compose verwijst 'db' naar de postgres-service.
DATABASE_URL="postgresql://ovp:CHANGE_ME@db:5432/ovp_portaal?schema=public"
# Gebruikt door docker-compose (postgres-service + samengestelde DATABASE_URL):
POSTGRES_USER="ovp"
POSTGRES_PASSWORD="CHANGE_ME_sterk_db_wachtwoord"
POSTGRES_DB="ovp_portaal"

# Domein voor de reverse proxy (Caddy, automatische HTTPS):
PORTAL_DOMAIN="portaal.ottovisseraccountants.nl"

# === Geheimen (elk minimaal 32 tekens; genereer met: openssl rand -base64 48) ===
# Ondertekent en verifieert sessiecookies + tekentokens (HMAC).
SESSION_SECRET="CHANGE_ME_min_32_tekens_random_geheim_______"
SIGNING_TOKEN_SECRET="CHANGE_ME_min_32_tekens_random_geheim_______"
# 32 bytes (base64 of hex) voor AES-256-GCM op opgeslagen documenten.
STORAGE_ENCRYPTION_KEY="CHANGE_ME_base64_of_hex_32_bytes____________"
# 32 bytes (base64 of hex) voor AES-256-GCM op TOTP-secrets in de database.
TOTP_ENCRYPTION_KEY="CHANGE_ME_base64_of_hex_32_bytes____________"

# === Documentopslag ===
# 'local' = versleuteld op schijf (MVP). Later: 's3'.
STORAGE_DRIVER="local"
STORAGE_DIR="/data/documents"

# === E-mail ===
# smtp | postmark | resend  (standaard smtp = Microsoft 365)
MAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"                 # false = STARTTLS op poort 587
SMTP_USER="noreply@ottovisseraccountants.nl"
SMTP_PASS="CHANGE_ME_app_wachtwoord"
MAIL_FROM="Otto Visser & Partners <noreply@ottovisseraccountants.nl>"
# Bezorgbaarheid: stel SPF + DKIM + DMARC in op het domein van MAIL_FROM en laat
# het afzenderadres met dat domein overeenkomen (voorkomt de spamfolder).
# Optioneel voor Postmark/Resend:
# POSTMARK_TOKEN=""
# RESEND_API_KEY=""

# === Sms (optioneel) ===
# Alleen nodig als cliënten 'sms' als verificatievoorkeur hebben.
# none | messagebird | twilio
SMS_PROVIDER="none"
SMS_ORIGINATOR="OttoVisser"
# MESSAGEBIRD_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+31..."

# === Archief: getekende stukken automatisch in de klantmap ===
# none = uit (standaard) · folder = naar een gekoppelde map/volume · sharepoint = Microsoft 365
ARCHIVE_DRIVER="none"
# Bij 'folder': map (koppel hier bijv. een netwerkschijf of gesynchroniseerde SharePoint-map aan):
ARCHIVE_DIR="/data/archive"
# Bij 'sharepoint' (Microsoft Graph, app-registratie met Sites.ReadWrite.All + admin consent):
# SHAREPOINT_TENANT_ID=""
# SHAREPOINT_CLIENT_ID=""
# SHAREPOINT_CLIENT_SECRET=""
# SHAREPOINT_DRIVE_ID=""          # id van de documentbibliotheek (drive)
# SHAREPOINT_BASE_FOLDER="Getekende stukken"

# === Virusscan op uploads (optioneel) ===
# none = uit (standaard) · clamav = scan via een ClamAV-daemon (zie docker-compose.yml).
# Let op: staat dit op 'clamav' en is de daemon onbereikbaar, dan worden uploads
# geweigerd (fail-closed).
VIRUS_SCAN="none"
CLAMD_HOST="clamav"
CLAMD_PORT="3310"

# === Beroepscertificaat: gekwalificeerd ondertekenen op persoonlijke titel ===
# none = uit (standaard; geen certificaat nodig, kantoorhandtekening = stempel)
# digidentity = PKIoverheid-beroepscertificaat in de cloud via de CSC-API.
# Per accountant zet je het aan onder Instellingen > Gebruikers.
PROFESSIONAL_SIGNING_DRIVER="none"
# Alleen bij 'digidentity' (OAuth2 client-credentials; testtoegang via Sales):
# DIGIDENTITY_BASE_URL="https://api-preprod.digidentity.eu"
# DIGIDENTITY_CLIENT_ID=""
# DIGIDENTITY_CLIENT_SECRET=""
# DIGIDENTITY_SCOPE=""

# === Beleid ===
# Geldigheidsduur tekenlink (dagen) en OTP (minuten).
SIGN_LINK_TTL_DAYS="14"
OTP_TTL_MINUTES="10"

# === Seed (alleen voor db:seed / eerste opstart) ===
SEED_ADMIN_EMAIL="mark@ottovisseraccountants.nl"
SEED_ADMIN_PASSWORD="Wijzig-Dit-Wachtwoord-1"
SEED_ADMIN_NAME="Mark"
