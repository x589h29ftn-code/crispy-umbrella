# === Kernconfiguratie ===
# Publieke URL van het portaal (gebruikt in e-maillinks). Geen slash op het einde.
APP_URL="https://portaal.ottovisseraccountants.nl"
NODE_ENV="production"

# === Database ===
# PostgreSQL-verbinding. In docker-compose verwijst 'db' naar de postgres-service.
DATABASE_URL="postgresql://ovp:CHANGE_ME@db:5432/ovp_portaal?schema=public"
# Gebruikt door docker-compose (postgres-service + samengestelde DATABASE_URL):
POSTGRES_USER="ovp"
POSTGRES_PASSWORD="CHANGE_ME_sterk_db_wachtwoord"
POSTGRES_DB="ovp_portaal"

# Domein voor de reverse proxy (Caddy, automatische HTTPS):
PORTAL_DOMAIN="portaal.ottovisseraccountants.nl"

# === Geheimen (elk minimaal 32 tekens; genereer met: openssl rand -base64 48) ===
# Ondertekent en verifieert sessiecookies + tekentokens (HMAC).
SESSION_SECRET="CHANGE_ME_min_32_tekens_random_geheim_______"
SIGNING_TOKEN_SECRET="CHANGE_ME_min_32_tekens_random_geheim_______"
# 32 bytes (base64 of hex) voor AES-256-GCM op opgeslagen documenten.
STORAGE_ENCRYPTION_KEY="CHANGE_ME_base64_of_hex_32_bytes____________"
# 32 bytes (base64 of hex) voor AES-256-GCM op TOTP-secrets in de database.
TOTP_ENCRYPTION_KEY="CHANGE_ME_base64_of_hex_32_bytes____________"

# === Documentopslag ===
# 'local' = versleuteld op schijf (MVP). Later: 's3'.
STORAGE_DRIVER="local"
STORAGE_DIR="/data/documents"

# === E-mail ===
# smtp | postmark | resend  (standaard smtp = Microsoft 365)
MAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"                 # false = STARTTLS op poort 587
SMTP_USER="noreply@ottovisseraccountants.nl"
SMTP_PASS="CHANGE_ME_app_wachtwoord"
MAIL_FROM="Otto Visser & Partners <noreply@ottovisseraccountants.nl>"
# Bezorgbaarheid: stel SPF + DKIM + DMARC in op het domein van MAIL_FROM en laat
# het afzenderadres met dat domein overeenkomen (voorkomt de spamfolder).
#
# --- Transactionele provider (aanbevolen voor ondertekenmail) ---
# Bij SMTP weet je alleen dat de mail is aangeboden, niet of hij is afgeleverd,
# gebounced of in spam belandde. Met postmark of resend koppelt het portaal de
# bezorgstatus terug en waarschuwt het als een uitnodiging niet aankomt.
# Gebruik hiervoor een APART subdomein (bv. mail.ottovisseraccountants.nl) met
# eigen SPF, DKIM en DMARC, zodat een mailincident het hoofddomein niet raakt.
# POSTMARK_TOKEN=""
POSTMARK_MESSAGE_STREAM="outbound"
# RESEND_API_KEY=""
# Openen meten via een tracking-pixel. Standaard uit: onbetrouwbaar in twee
# richtingen, en het komt bewust niet op het ondertekencertificaat.
MAIL_TRACK_OPENS="false"
#
# --- Beveiliging van het webhook-eindpunt (/api/webhooks/mail) ---
# Zonder deze instellingen worden ALLE webhooks geweigerd; nooit stilzwijgend open.
# Postmark: zet de webhook-URL in met basicauth, bijvoorbeeld
#   https://hookuser:GEHEIM@portaal.example.nl/api/webhooks/mail
# MAIL_WEBHOOK_USER="hookuser"
# MAIL_WEBHOOK_PASSWORD="CHANGE_ME_lang_random"
# Optioneel extra slot: komma-gescheiden IP-lijst van de provider. Leeg = geen
# IP-beperking (basicauth blijft dan de enige controle).
# MAIL_WEBHOOK_IPS=""
# Resend gebruikt in plaats daarvan een Svix-signatuur:
# RESEND_WEBHOOK_SECRET="whsec_..."

# === Sms (optioneel) ===
# Alleen nodig als cliënten 'sms' als verificatievoorkeur hebben.
# none | messagebird | twilio
SMS_PROVIDER="none"
SMS_ORIGINATOR="OttoVisser"
# MESSAGEBIRD_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+31..."

# === Archief: getekende stukken automatisch in de klantmap ===
# none = uit (standaard) · folder = naar een gekoppelde map/volume · sharepoint = Microsoft 365
ARCHIVE_DRIVER="none"
# Bij 'folder': map (koppel hier bijv. een netwerkschijf of gesynchroniseerde SharePoint-map aan):
ARCHIVE_DIR="/data/archive"
# Bij 'sharepoint' (Microsoft Graph, app-registratie met Sites.ReadWrite.All + admin consent):
# SHAREPOINT_TENANT_ID=""
# SHAREPOINT_CLIENT_ID=""
# SHAREPOINT_CLIENT_SECRET=""
# SHAREPOINT_DRIVE_ID=""          # id van de documentbibliotheek (drive)
# SHAREPOINT_BASE_FOLDER="Getekende stukken"

# === Virusscan op uploads (optioneel) ===
# none = uit (standaard) · clamav = scan via een ClamAV-daemon (zie docker-compose.yml).
# Let op: staat dit op 'clamav' en is de daemon onbereikbaar, dan worden uploads
# geweigerd (fail-closed).
VIRUS_SCAN="none"
CLAMD_HOST="clamav"
CLAMD_PORT="3310"

# === Cryptografische verzegeling (PAdES) via de sealer-sidecar ===
# none = uit (alleen zichtbare stempels + ondertekencertificaat, geen digitaal
#        zegel: de ontvanger kan de echtheid dan niet zelf controleren)
# sealer = verzegelen met pyHanko in de interne sealer-container (aanbevolen)
SEAL_MODE="none"
SEALER_URL="http://sealer:8000"
# Shared secret tussen web/worker en de sealer (genereer: openssl rand -base64 48):
SEALER_SHARED_SECRET="CHANGE_ME_min_32_tekens_random_geheim_______"
SEALER_TIMEOUT_MS="60000"
# Ook een organisatiezegel zetten als er al een gekwalificeerde handtekening staat?
SEAL_WHEN_QUALIFIED_PRESENT="false"
# Welke driver de sealer gebruikt voor het organisatiezegel: csc | globalsign_dss
SEAL_DRIVER="csc"
# Bij 'csc' (Digidentity/Cleverbase eSeal via de Cloud Signature Consortium-API):
# SEAL_CSC_BASE_URL=""
# SEAL_CSC_CREDENTIAL_ID=""
# SEAL_CSC_OAUTH_TOKEN=""
# SEAL_CSC_SAD=""
# Bij 'globalsign_dss':
# SEAL_DSS_API_BASE="https://emea.api.dss.globalsign.com:8443/v2"
# SEAL_DSS_API_KEY=""
# SEAL_DSS_API_SECRET=""
# SEAL_DSS_SIGNER_ID=""
# SEAL_DSS_CERT_PEM=""
# LET OP: de private sleutel staat altijd in een cloud-HSM bij de aanbieder.
# Zet nooit een .pfx of .p12 op deze server.

# === Tijdstempel (TSA) — verplicht voor PAdES-B-LT ===
# Gebruik een (gekwalificeerde) tijdstempeldienst van de EU-vertrouwenslijst.
# Zonder tijdstempel kun je niet aantonen wanneer er is verzegeld.
# TSA_URL="https://tsa.example.eu/tsr"
TSA_AUTH_MODE="none"                # none | basic | bearer
# TSA_USERNAME=""
# TSA_PASSWORD=""
TSA_TIMEOUT_MS="10000"
PADES_LEVEL="lt"                    # lt | lta (lta voegt een document-timestamp toe)

# === Achtergrondwerker (verzegeling opnieuw proberen, herinneringen, opruimen) ===
WORKER_POLL_MS="15000"
WORKER_BATCH="5"

# === Proxy ===
# Aantal vertrouwde proxies vóór de app. Caddy alleen = 1. Bepaalt welke waarde
# uit X-Forwarded-For als client-IP wordt gebruikt.
TRUSTED_PROXY_HOPS="1"

# === Beroepscertificaat: gekwalificeerd ondertekenen op persoonlijke titel ===
# none = uit (standaard; geen certificaat nodig, kantoorhandtekening = stempel)
# digidentity = PKIoverheid-beroepscertificaat in de cloud via de CSC-API.
# Per accountant zet je het aan onder Instellingen > Gebruikers.
PROFESSIONAL_SIGNING_DRIVER="none"
# Alleen bij 'digidentity' (OAuth2 client-credentials; testtoegang via Sales):
# DIGIDENTITY_BASE_URL="https://api-preprod.digidentity.eu"
# DIGIDENTITY_CLIENT_ID=""
# DIGIDENTITY_CLIENT_SECRET=""
# DIGIDENTITY_SCOPE=""

# Alleen bij 'cleverbase'. Hier autoriseert de ACCOUNTANT zelf: het portaal stuurt
# hem via een browserredirect naar Cleverbase, waar hij in de app met pincode
# bevestigt. Eén bevestiging dekt tot 50 documenten.
# CLEVERBASE_CSC_BASE_URL=""
# CLEVERBASE_CSC_CLIENT_ID=""
# CLEVERBASE_CSC_CLIENT_SECRET=""
# Leeg = geen omgeving gekozen (de driver weigert dan te werken).
# stub = de OPENBARE teststub van Cleverbase; production = eigen clientgegevens.
CLEVERBASE_CSC_ENV=""
# Absolute HTTPS-URL, vooraf bij Cleverbase te registreren. Wijzigen betekent
# opnieuw registreren, dus houd hem stabiel. Registreer meteen ook een
# acceptatie-URL, anders moet je later terug.
# CLEVERBASE_REDIRECT_URI="https://portaal.ottovisseraccountants.nl/api/csc/callback"
CLEVERBASE_MAX_BATCH="50"
CLEVERBASE_SIGN_TIMEOUT_MS="300000"
CLEVERBASE_CRL_URL="https://pki.cleverbase.com/cleverbase3c.crl"
#
# --- Openbare teststub van Cleverbase (ONTWIKKELEN/TESTEN, NOOIT PRODUCTIE) ---
# Deze gegevens staan in hun documentatie en zijn dus wereldwijd bekend. Het
# portaal weigert te starten als NODE_ENV=production met CLEVERBASE_CSC_ENV=stub
# of met dit client-id. Elke redirect-URI is bij de stub toegestaan.
#   CLEVERBASE_CSC_CLIENT_ID="6dd5f48d-bcd9-4a98-8a4c-5c82182f5be4"
#   CLEVERBASE_CSC_CLIENT_SECRET="11628999-cb61-4c62-8e1f-09699dcb5521"
#   CLEVERBASE_CSC_ENV="stub"
# Uitzoeken tegen de stub:  npm run csc:check

# === Beleid ===
# Geldigheidsduur tekenlink (dagen) en OTP (minuten).
SIGN_LINK_TTL_DAYS="14"
OTP_TTL_MINUTES="10"

# === Seed (alleen voor db:seed / eerste opstart) ===
SEED_ADMIN_EMAIL="mark@ottovisseraccountants.nl"
SEED_ADMIN_PASSWORD="Wijzig-Dit-Wachtwoord-1"
SEED_ADMIN_NAME="Mark"
