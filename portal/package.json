{
  "name": "ovp-ondertekenportaal",
  "version": "0.1.0",
  "private": true,
  "description": "Online ondertekenportaal — documenten importeren, ondertekenen en veilig laten tekenen in de browser.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx --conditions react-server scripts/worker.ts",
    "audit:verify": "tsx --conditions react-server scripts/verify-audit-chain.ts",
    "csc:check": "tsx --conditions react-server scripts/csc-stub-check.ts",
    "keys:rotate": "tsx --conditions react-server scripts/rotate-keys.ts",
    "restore:verify": "tsx --conditions react-server scripts/verify-restore.ts",
    "retention:purge": "tsx --conditions react-server scripts/purge-retention.ts",
    "test:opstart": "tsx --conditions react-server scripts/regressie/opstartregels.ts",
    "test:audit": "tsx --conditions react-server scripts/regressie/audit-en-bewaartermijn.ts",
    "test:gelijktijdig": "tsx --conditions react-server scripts/regressie/gelijktijdig-ondertekenen.ts",
    "test:sessie": "tsx --conditions react-server scripts/regressie/ondertekensessie.ts",
    "test:regressie": "npm run test:opstart && npm run test:audit && npm run test:gelijktijdig && npm run test:sessie"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "@e965/xlsx": "^0.20.3",
    "@node-rs/argon2": "^2.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.0",
    "nanoid": "^5.1.16",
    "next": "^14.2.35",
    "nodemailer": "^9.0.3",
    "otpauth": "^9.3.6",
    "pdfjs-dist": "^4.8.69",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^5.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
